<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Original 24x24 color icons drawn as vector geometry (no image files). -->

    <Pen x:Key="Pen.Dark" Brush="#455A64" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.Gray" Brush="#78909C" Thickness="1.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.Thin" Brush="#B0BEC5" Thickness="1" StartLineCap="Round" EndLineCap="Round" />
    <Pen x:Key="Pen.Blue" Brush="#1565C0" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.BlueBold" Brush="#1E88E5" Thickness="2.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.Teal" Brush="#00796B" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.Green" Brush="#2E7D32" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.GreenBold" Brush="#2E7D32" Thickness="2.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.Orange" Brush="#EF6C00" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.Red" Brush="#C62828" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.RedBold" Brush="#E53935" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.Purple" Brush="#6A1B9A" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.Gold" Brush="#F9A825" Thickness="2.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.White" Brush="White" Thickness="2.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="Pen.DashBlue" Brush="#1E88E5" Thickness="1.7" StartLineCap="Flat" EndLineCap="Flat">
        <Pen.DashStyle>
            <DashStyle Dashes="2.2,1.6" />
        </Pen.DashStyle>
    </Pen>
    <Pen x:Key="Pen.DashPurple" Brush="#8E24AA" Thickness="1.7" StartLineCap="Flat" EndLineCap="Flat">
        <Pen.DashStyle>
            <DashStyle Dashes="2.2,1.6" />
        </Pen.DashStyle>
    </Pen>

    <!-- Connect to server: a plug -->
    <DrawingImage x:Key="Icon.Server">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Teal}" Geometry="M9,2 V7 M15,2 V7" />
                <GeometryDrawing Brush="#26A69A" Pen="{StaticResource Pen.Teal}" Geometry="M5.5,7 H18.5 V12 A6.5,6.5 0 0 1 12,18.5 A6.5,6.5 0 0 1 5.5,12 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Teal}" Geometry="M12,18.5 V22" />
                <GeometryDrawing Brush="#B2DFDB" Geometry="M8.5,9.5 H15.5 V12 A3.5,3.5 0 0 1 12,15.5 A3.5,3.5 0 0 1 8.5,12 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Import DXF: tray with an arrow dropping in -->
    <DrawingImage x:Key="Icon.Import">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#E3F2FD" Pen="{StaticResource Pen.Blue}" Geometry="M3.5,14 V20.5 H20.5 V14" />
                <GeometryDrawing Pen="{StaticResource Pen.Orange}" Geometry="M12,2.5 V15 M7,10.5 L12,15.5 L17,10.5" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Cancel import: red disc with a cross -->
    <DrawingImage x:Key="Icon.Cancel">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#EF5350" Pen="{StaticResource Pen.Red}" Geometry="M12,3 A9,9 0 1 0 12.01,3 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.White}" Geometry="M8.2,8.2 L15.8,15.8 M15.8,8.2 L8.2,15.8" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Delete imported DXF: a page with a red minus badge -->
    <DrawingImage x:Key="Icon.DeleteDxf">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="White" Pen="{StaticResource Pen.Gray}" Geometry="M5,2.5 H13.5 L18.5,7.5 V20.5 H5 Z" />
                <GeometryDrawing Brush="#CFD8DC" Geometry="M13.5,2.5 V7.5 H18.5 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Thin}" Geometry="M8,11 H15.5 M8,14 H13" />
                <GeometryDrawing Brush="#E53935" Pen="{StaticResource Pen.Red}" Geometry="M17.5,12.5 A5,5 0 1 0 17.51,12.5 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.White}" Geometry="M15,17.5 H20" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Zoom in / out / extent: a viewfinder -->
    <DrawingImage x:Key="Icon.ZoomIn">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Dark}" Geometry="M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16" />
                <GeometryDrawing Brush="#E3F2FD" Geometry="M12,5.5 A6.5,6.5 0 1 0 12.01,5.5 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.BlueBold}" Geometry="M12,8.5 V15.5 M8.5,12 H15.5" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.ZoomOut">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Dark}" Geometry="M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16" />
                <GeometryDrawing Brush="#FFEBEE" Geometry="M12,5.5 A6.5,6.5 0 1 0 12.01,5.5 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.RedBold}" Geometry="M8.5,12 H15.5" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Fit">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Dark}" Geometry="M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16" />
                <GeometryDrawing Brush="#FFE0B2" Pen="{StaticResource Pen.Orange}" Geometry="M7.5,15.5 L9,8.5 H16 L15,16 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Reset view: one round arrow -->
    <DrawingImage x:Key="Icon.Reset">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Teal}" Geometry="M19,12 A7,7 0 1 1 15.4,5.9" />
                <GeometryDrawing Brush="#00897B" Geometry="M12.8,2.8 L19,4.2 L15,9 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Refresh: two chasing arrows -->
    <DrawingImage x:Key="Icon.Refresh">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Teal}" Geometry="M4.8,11 A7.5,7.5 0 0 1 17.7,7.3 M19.2,13 A7.5,7.5 0 0 1 6.3,16.7" />
                <GeometryDrawing Brush="#00897B" Geometry="M20.5,3.5 L20,9.5 L14.2,8.2 Z M3.5,20.5 L4,14.5 L9.8,15.8 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Deselect: dashed selection box with a red cross -->
    <DrawingImage x:Key="Icon.Deselect">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#E3F2FD" Pen="{StaticResource Pen.DashBlue}" Geometry="M3.5,4.5 H17 V18 H3.5 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.RedBold}" Geometry="M13,13 L21,21 M21,13 L13,21" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Edit mode: a shape with a pencil -->
    <DrawingImage x:Key="Icon.Edit">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#E3F2FD" Pen="{StaticResource Pen.Blue}" Geometry="M3.5,18.5 L4.5,8 L12,5.5 L14,11" />
                <GeometryDrawing Brush="#FFB74D" Pen="{StaticResource Pen.Orange}" Geometry="M11,21 L12,16 L19.5,6.5 L22,9 L14.5,18.5 Z" />
                <GeometryDrawing Brush="#5D4037" Geometry="M11,21 L12,16 L14.5,18.5 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Save edits: green tile with a check -->
    <DrawingImage x:Key="Icon.Save">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#43A047" Pen="{StaticResource Pen.Green}" Geometry="M5.5,3 H18.5 A2.5,2.5 0 0 1 21,5.5 V18.5 A2.5,2.5 0 0 1 18.5,21 H5.5 A2.5,2.5 0 0 1 3,18.5 V5.5 A2.5,2.5 0 0 1 5.5,3 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.White}" Geometry="M7.5,12.5 L10.5,15.5 L16.5,8.5" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Discard: revert arrow -->
    <DrawingImage x:Key="Icon.Discard">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Orange}" Geometry="M9,7.5 H14.5 A5,5 0 0 1 14.5,17.5 H8" />
                <GeometryDrawing Brush="#EF6C00" Geometry="M3.5,7.5 L10,3 V12 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Duplicate: two squares with a plus badge -->
    <DrawingImage x:Key="Icon.Duplicate">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="White" Pen="{StaticResource Pen.Gray}" Geometry="M3.5,3.5 H13 V13 H3.5 Z" />
                <GeometryDrawing Brush="#BBDEFB" Pen="{StaticResource Pen.Blue}" Geometry="M8.5,9.5 H18.5 V19.5 H8.5 Z" />
                <GeometryDrawing Brush="#43A047" Geometry="M20,2 A4,4 0 1 0 20.01,2 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.White}" Geometry="M20,3.8 V8.2 M17.8,6 H22.2" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Delete object: a shape with a red cross -->
    <DrawingImage x:Key="Icon.DeleteObject">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#ECEFF1" Pen="{StaticResource Pen.Gray}" Geometry="M3.5,6 H16 V17.5 H3.5 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.RedBold}" Geometry="M12.5,11 L21,19.5 M21,11 L12.5,19.5" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Group: two members inside a dashed box -->
    <DrawingImage x:Key="Icon.Group">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#F3E5F5" Pen="{StaticResource Pen.DashPurple}" Geometry="M2.5,3.5 H21.5 V20.5 H2.5 Z" />
                <GeometryDrawing Brush="#CE93D8" Pen="{StaticResource Pen.Purple}" Geometry="M5.5,6.5 H12 V13 H5.5 Z" />
                <GeometryDrawing Brush="#E1BEE7" Pen="{StaticResource Pen.Purple}" Geometry="M11.5,11.5 H18.5 V17.5 H11.5 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Vertex edit: polygon with square handles -->
    <DrawingImage x:Key="Icon.Vertex">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#E3F2FD" Pen="{StaticResource Pen.Blue}" Geometry="M5,18 L4,8 L13,4.5 L20,12 L15,19.5 Z" />
                <GeometryDrawing Brush="White" Pen="{StaticResource Pen.Dark}" Geometry="M2.6,6.6 H5.4 V9.4 H2.6 Z M11.6,3.1 H14.4 V5.9 H11.6 Z M18.6,10.6 H21.4 V13.4 H18.6 Z M3.6,16.6 H6.4 V19.4 H3.6 Z" />
                <GeometryDrawing Brush="#FFCA28" Pen="{StaticResource Pen.Dark}" Geometry="M13.6,18.1 H16.4 V20.9 H13.6 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Snap to grid: grid with a snapped target -->
    <DrawingImage x:Key="Icon.Snap">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Thin}" Geometry="M3,7 H21 M3,13 H21 M3,19 H21 M7,3 V21 M13,3 V21 M19,3 V21" />
                <GeometryDrawing Brush="#FFF3E0" Pen="{StaticResource Pen.Orange}" Geometry="M13,8.8 A4.2,4.2 0 1 0 13.01,8.8 Z" />
                <GeometryDrawing Brush="#EF6C00" Geometry="M11.4,13 A1.6,1.6 0 1 0 14.6,13 A1.6,1.6 0 1 0 11.4,13 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Validate: polygon with a check badge -->
    <DrawingImage x:Key="Icon.Validate">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#E3F2FD" Pen="{StaticResource Pen.Blue}" Geometry="M3.5,16.5 L5,6.5 L13,4 L18,10 L11.5,18.5 Z" />
                <GeometryDrawing Brush="#43A047" Pen="{StaticResource Pen.Green}" Geometry="M18,13 A5,5 0 1 0 18.01,13 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.White}" Geometry="M15.3,18 L17.3,20 L20.8,15.8" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Add point: a map pin -->
    <DrawingImage x:Key="Icon.AddPoint">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#EF5350" Pen="{StaticResource Pen.Red}" Geometry="M12,22 C12,22 4.8,14.6 4.8,9.6 A7.2,7.2 0 0 1 19.2,9.6 C19.2,14.6 12,22 12,22 Z" />
                <GeometryDrawing Brush="White" Geometry="M12,7 A2.8,2.8 0 1 0 12.01,7 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Equipment-only import: funnel with a block -->
    <DrawingImage x:Key="Icon.EquipOnly">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#80CBC4" Pen="{StaticResource Pen.Teal}" Geometry="M3,4 H21 L14,12.5 V19.5 L10,17.5 V12.5 Z" />
                <GeometryDrawing Brush="#FFB74D" Pen="{StaticResource Pen.Orange}" Geometry="M14.5,15 H21 V21 H14.5 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Load layers: a stack of sheets -->
    <DrawingImage x:Key="Icon.Layers">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#A5D6A7" Pen="{StaticResource Pen.Green}" Geometry="M3,16 L12,21 L21,16 L12,11 Z" />
                <GeometryDrawing Brush="#80CBC4" Pen="{StaticResource Pen.Teal}" Geometry="M3,12 L12,17 L21,12 L12,7 Z" />
                <GeometryDrawing Brush="#90CAF9" Pen="{StaticResource Pen.Blue}" Geometry="M3,8 L12,13 L21,8 L12,3 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Show all / hide all layers -->
    <DrawingImage x:Key="Icon.ShowAll">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="White" Pen="{StaticResource Pen.Blue}" Geometry="M2,12 C6,5.5 18,5.5 22,12 C18,18.5 6,18.5 2,12 Z" />
                <GeometryDrawing Brush="#1E88E5" Geometry="M12,8.2 A3.8,3.8 0 1 0 12.01,8.2 Z" />
                <GeometryDrawing Brush="White" Geometry="M12.8,10.4 A1.3,1.3 0 1 0 12.81,10.4 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.HideAll">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#ECEFF1" Pen="{StaticResource Pen.Gray}" Geometry="M2,12 C6,5.5 18,5.5 22,12 C18,18.5 6,18.5 2,12 Z" />
                <GeometryDrawing Brush="#90A4AE" Geometry="M12,8.2 A3.8,3.8 0 1 0 12.01,8.2 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.RedBold}" Geometry="M4.5,20 L19.5,4" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Layer style: a paint palette -->
    <DrawingImage x:Key="Icon.Style">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#FFF3E0" Pen="{StaticResource Pen.Dark}" Geometry="M12,3 C6.5,3 3,7 3,12 C3,17 7,21 12,21 C14,21 15,19.6 14.2,18.2 C13.4,16.8 14.2,15.3 16,15.3 H18 C19.9,15.3 21,13.8 21,12 C21,7 17,3 12,3 Z" />
                <GeometryDrawing Brush="#E53935" Geometry="M9.2,7.1 A1.7,1.7 0 1 0 9.21,7.1 Z" />
                <GeometryDrawing Brush="#1E88E5" Geometry="M13.7,5.3 A1.7,1.7 0 1 0 13.71,5.3 Z" />
                <GeometryDrawing Brush="#43A047" Geometry="M17.2,8.3 A1.7,1.7 0 1 0 17.21,8.3 Z" />
                <GeometryDrawing Brush="#FB8C00" Geometry="M7.5,11.9 A1.7,1.7 0 1 0 7.51,11.9 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Users: two people -->
    <DrawingImage x:Key="Icon.Users">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#CE93D8" Geometry="M16.5,5.5 A3.2,3.2 0 1 0 16.51,5.5 Z M11.5,19.5 C11.5,13.5 22.5,13.5 22.5,19.5 Z" />
                <GeometryDrawing Brush="#8E24AA" Pen="{StaticResource Pen.Purple}" Geometry="M8.5,6 A3.6,3.6 0 1 0 8.51,6 Z M1.8,20.5 C1.8,13.5 15.2,13.5 15.2,20.5 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Password: a key -->
    <DrawingImage x:Key="Icon.Key">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#FFF59D" Pen="{StaticResource Pen.Gold}" Geometry="M8,8.2 A4.3,4.3 0 1 0 8.01,8.2 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.Gold}" Geometry="M11.2,11.2 L21,21 M17.5,17.5 L20,15 M14.5,14.5 L16.8,12.2" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Log out / log in: a door with an arrow -->
    <DrawingImage x:Key="Icon.Logout">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#ECEFF1" Pen="{StaticResource Pen.Gray}" Geometry="M3.5,3.5 H13 V20.5 H3.5 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.RedBold}" Geometry="M10,12 H21 M17,8 L21,12 L17,16" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Icon.Login">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#ECEFF1" Pen="{StaticResource Pen.Gray}" Geometry="M11,3.5 H20.5 V20.5 H11 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.GreenBold}" Geometry="M3,12 H15 M11,8 L15,12 L11,16" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- About -->
    <DrawingImage x:Key="Icon.About">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Brush="#E3F2FD" Pen="{StaticResource Pen.Blue}" Geometry="M12,3 A9,9 0 1 0 12.01,3 Z" />
                <GeometryDrawing Brush="#1565C0" Geometry="M12,6.3 A1.4,1.4 0 1 0 12.01,6.3 Z" />
                <GeometryDrawing Pen="{StaticResource Pen.BlueBold}" Geometry="M12,10.5 V17" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
