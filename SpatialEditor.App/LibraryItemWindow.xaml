<Window x:Class="SpatialEditor.App.LibraryItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniDT SE - Library item" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F8">
    <DockPanel Margin="18">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Text="Library item" />
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="20" Foreground="#52606D" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="Save" Padding="20,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Padding="20,5" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Code (unique)" Margin="0,6,0,3" />
            <TextBox x:Name="CodeTextBox" />
            <TextBlock Text="Name" Margin="0,6,0,3" />
            <TextBox x:Name="NameTextBox" />
            <TextBlock Text="Category" Margin="0,6,0,3" />
            <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Path" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Vendor" Margin="0,0,0,3" />
                    <TextBox x:Name="VendorTextBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Model no." Margin="0,0,0,3" />
                    <TextBox x:Name="ModelTextBox" />
                </StackPanel>
            </Grid>
            <Grid x:Name="EditOnlyPanel" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Height (m)" Margin="0,0,0,3" />
                    <TextBox x:Name="HeightTextBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Status" Margin="0,0,0,3" />
                    <ComboBox x:Name="StatusCombo" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="DescriptionLabel" Text="Description" Margin="0,6,0,3" />
            <TextBox x:Name="DescriptionTextBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </DockPanel>
</Window>
