<Window x:Class="SpatialEditor.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniDT SE - Log in" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#DE3A54">
    <Grid>
        <!-- Background: same light-red gradient and grid as the app icon -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F67082" Offset="0" />
                <GradientStop Color="#DE3A54" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Viewbox="0,0,32,32" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 L32,0 M0,0 L0,32">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#40FFFFFF" Thickness="1.2" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Artwork: equipment plan being edited (same motif as the app icon), fully visible above the form -->
        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="24,20,24,8" IsHitTestVisible="False">
            <Canvas Width="520" Height="360">
                <!-- load ports -->
                <Rectangle Canvas.Left="30" Canvas.Top="70" Width="30" Height="48" Fill="#FFF0F2" Stroke="#961932" StrokeThickness="4" />
                <Rectangle Canvas.Left="30" Canvas.Top="150" Width="30" Height="48" Fill="#FFF0F2" Stroke="#961932" StrokeThickness="4" />
                <Rectangle Canvas.Left="400" Canvas.Top="95" Width="36" Height="100" Fill="#FFF0F2" Stroke="#961932" StrokeThickness="4" />
                <!-- equipment body -->
                <Rectangle Canvas.Left="60" Canvas.Top="40" Width="340" Height="210" Fill="#FFF0F2" Stroke="#961932" StrokeThickness="5" />
                <!-- chamber -->
                <Ellipse Canvas.Left="125" Canvas.Top="65" Width="160" Height="160" Fill="#FFC8D0" Stroke="#961932" StrokeThickness="5" />
                <Ellipse Canvas.Left="175" Canvas.Top="115" Width="60" Height="60" Stroke="#961932" StrokeThickness="4" />
                <Path Stroke="#961932" StrokeThickness="3.5" Data="M125,145 L285,145 M205,65 L205,225" />
                <!-- selection grips -->
                <Rectangle Canvas.Left="50" Canvas.Top="30" Width="20" Height="20" Fill="#1E6EE6" Stroke="White" StrokeThickness="3" />
                <Rectangle Canvas.Left="230" Canvas.Top="30" Width="20" Height="20" Fill="#1E6EE6" Stroke="White" StrokeThickness="3" />
                <Rectangle Canvas.Left="390" Canvas.Top="30" Width="20" Height="20" Fill="#1E6EE6" Stroke="White" StrokeThickness="3" />
                <Rectangle Canvas.Left="50" Canvas.Top="240" Width="20" Height="20" Fill="#1E6EE6" Stroke="White" StrokeThickness="3" />
                <Rectangle Canvas.Left="230" Canvas.Top="240" Width="20" Height="20" Fill="#1E6EE6" Stroke="White" StrokeThickness="3" />
                <Rectangle Canvas.Left="390" Canvas.Top="240" Width="20" Height="20" Fill="#FFC428" Stroke="White" StrokeThickness="3" />
                <!-- dimension line -->
                <Path Stroke="#FFD646" StrokeThickness="5" Data="M60,310 L400,310 M60,290 L60,330 M400,290 L400,330 M60,310 L82,301 M60,310 L82,319 M400,310 L378,301 M400,310 L378,319" />
                <!-- pencil editing the highlighted grip -->
                <Canvas Canvas.Left="400" Canvas.Top="250">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="-135" />
                    </Canvas.RenderTransform>
                    <Polygon Points="0,0 90,-26 90,26" Fill="#FAD6AA" />
                    <Polygon Points="0,0 32,-10 32,10" Fill="#3C3232" />
                    <Rectangle Canvas.Top="-26" Canvas.Left="90" Width="230" Height="52" Fill="#FFBE28" />
                    <Rectangle Canvas.Top="-26" Canvas.Left="90" Width="230" Height="10" Fill="#FFE278" />
                    <Rectangle Canvas.Top="16" Canvas.Left="90" Width="230" Height="10" Fill="#E18C14" />
                    <Rectangle Canvas.Top="-26" Canvas.Left="320" Width="34" Height="52" Fill="#BEC3CD" />
                    <Rectangle Canvas.Top="-26" Canvas.Left="354" Width="56" Height="52" Fill="#FF7896" />
                </Canvas>
            </Canvas>
        </Viewbox>

        <!-- Login form at the bottom so the artwork stays visible -->
        <Border Grid.Row="1" Margin="20,0,20,20" Padding="20,14,20,16" CornerRadius="8"
                Background="#F2FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                        <TextBlock Text="OmniDT SE" FontSize="20" FontWeight="Bold" Foreground="#A8183A" />
                        <TextBlock Text="Spatial Editor" FontSize="11" Foreground="#52606D" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Text="Log in" />
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" MinHeight="18" Foreground="#52606D" />
                    </StackPanel>
                </DockPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="ID" Margin="0,4,0,3" />
                        <TextBox x:Name="LoginIdTextBox" Padding="3" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Password" Margin="0,4,0,3" />
                        <PasswordBox x:Name="PasswordInput" Padding="3" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock x:Name="NameLabel" Text="Name" Margin="0,8,0,3" Visibility="Collapsed" />
                        <TextBox x:Name="NameTextBox" Padding="3" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock x:Name="ConfirmLabel" Text="Confirm password" Margin="0,8,0,3" Visibility="Collapsed" />
                        <PasswordBox x:Name="ConfirmInput" Padding="3" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="OkButton" Content="Log in" Padding="22,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
                    <Button Content="Cancel" Padding="22,5" IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
