<Window x:Class="SpatialEditor.App.VersionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Version Manager" Width="980" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6F8">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <CheckBox x:Name="ShowAutoCheck" DockPanel.Dock="Right" Content="Show automatic versions" IsChecked="True"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ShowAuto_Changed" Unchecked="ShowAuto_Changed" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button x:Name="SaveButton" Content="Save new version…" Padding="10,4" Margin="0,0,6,4" Click="Save_Click" />
            <Button x:Name="CompareButton" Content="Compare" Padding="10,4" Margin="0,0,6,4" Click="Compare_Click"
                    ToolTip="One version selected: compare with the working copy. Two selected (Ctrl+click): compare them." />
            <Button x:Name="RestoreButton" Content="Restore" Padding="10,4" Margin="0,0,6,4" Click="Restore_Click" />
            <Button x:Name="BranchButton" Content="Branch to new drawing…" Padding="10,4" Margin="0,0,6,4" Click="Branch_Click" />
            <Button x:Name="BaselineButton" Content="Set / release baseline" Padding="10,4" Margin="0,0,6,4" Click="Baseline_Click" />
            <Button x:Name="ArchiveButton" Content="Archive / unarchive" Padding="10,4" Margin="0,0,6,4" Click="Archive_Click" />
            <Button x:Name="EditButton" Content="Rename…" Padding="10,4" Margin="0,0,6,4" Click="Edit_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Padding="10,4" Margin="0,0,6,4" Click="Delete_Click" />
            <Button x:Name="ExportButton" Content="Export as DXF…" Padding="10,4" Margin="0,0,6,4" Click="Export_Click" />
        </WrapPanel>

        <ListView x:Name="VersionList" Grid.Row="2" SelectionMode="Extended" SelectionChanged="VersionList_SelectionChanged"
                  MouseDoubleClick="VersionList_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="46" DisplayMemberBinding="{Binding No}" />
                    <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Label}" />
                    <GridViewColumn Header="Kind" Width="70" DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding StatusText}" />
                    <GridViewColumn Header="By" Width="90" DisplayMemberBinding="{Binding Author}" />
                    <GridViewColumn Header="Time" Width="130" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn Header="Equipment" Width="70" DisplayMemberBinding="{Binding BlockCount}" />
                    <GridViewColumn Header="Other" Width="50" DisplayMemberBinding="{Binding FeatureCount}" />
                    <GridViewColumn Header="From" Width="50" DisplayMemberBinding="{Binding Parent}" />
                    <GridViewColumn Header="Comment" Width="260" DisplayMemberBinding="{Binding Comment}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="3" Margin="0,10,0,4">
            <Button x:Name="ShowInViewButton" DockPanel.Dock="Right" Content="Show in 2D view" Padding="12,4" Click="ShowInView_Click" IsEnabled="False" />
            <Button x:Name="CsvButton" DockPanel.Dock="Right" Content="Export CSV…" Padding="12,4" Margin="0,0,6,0" Click="Csv_Click" IsEnabled="False" />
            <TextBlock x:Name="DiffHeaderText" FontWeight="SemiBold" VerticalAlignment="Center" Text="Comparison" />
        </DockPanel>

        <ListView x:Name="DiffList" Grid.Row="4">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Change" Width="90" DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn Header="Object" Width="200" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Layer" Width="120" DisplayMemberBinding="{Binding Layer}" />
                    <GridViewColumn Header="Before" Width="220" DisplayMemberBinding="{Binding Before}" />
                    <GridViewColumn Header="After" Width="240" DisplayMemberBinding="{Binding After}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="20,5" IsCancel="True" />
            <TextBlock x:Name="MessageText" Foreground="#52606D" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
