<Window x:Class="SpatialEditor.App.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password" Height="340" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F8">
    <DockPanel Margin="18">
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" MinHeight="34" Foreground="#52606D" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Padding="20,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Padding="20,5" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="OldLabel" Text="Current password" Margin="0,8,0,3" />
            <PasswordBox x:Name="OldInput" />
            <TextBlock Text="New password" Margin="0,8,0,3" />
            <PasswordBox x:Name="NewInput" />
            <TextBlock Text="Confirm new password" Margin="0,8,0,3" />
            <PasswordBox x:Name="ConfirmInput" />
            <CheckBox x:Name="MustChangeCheckBox" Content="Require a change at next login" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
