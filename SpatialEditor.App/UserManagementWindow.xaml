<Window x:Class="SpatialEditor.App.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User management" Height="560" Width="860"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Grid Margin="14">
        <TabControl x:Name="Tabs">
            <TabItem Header="Users">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Add" Padding="12,4" Margin="0,0,6,0" Click="AddUser_Click" />
                        <Button Content="Edit" Padding="12,4" Margin="0,0,6,0" Click="EditUser_Click" />
                        <Button Content="Reset password" Padding="12,4" Margin="0,0,6,0" Click="ResetPassword_Click" />
                        <Button Content="Unlock" Padding="12,4" Margin="0,0,6,0" Click="UnlockUser_Click" />
                        <Button Content="Delete" Padding="12,4" Margin="0,0,6,0" Click="DeleteUser_Click" />
                        <Button Content="Refresh" Padding="12,4" Click="Refresh_Click" />
                    </WrapPanel>
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="EditUser_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding LoginId}" Width="120" />
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="150" />
                            <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="*" />
                            <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="60" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                            <DataGridTextColumn Header="Last login" Binding="{Binding LastLogin}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Roles">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Add" Padding="12,4" Margin="0,0,6,0" Click="AddRole_Click" />
                        <Button Content="Edit" Padding="12,4" Margin="0,0,6,0" Click="EditRole_Click" />
                        <Button Content="Delete" Padding="12,4" Margin="0,0,6,0" Click="DeleteRole_Click" />
                        <Button Content="Refresh" Padding="12,4" Click="Refresh_Click" />
                    </WrapPanel>
                    <DataGrid x:Name="RolesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="EditRole_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Built-in" Binding="{Binding BuiltIn}" Width="70" />
                            <DataGridTextColumn Header="Users" Binding="{Binding UserCount}" Width="60" />
                            <DataGridTextColumn Header="Permissions" Binding="{Binding PermissionCount}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="AuditTab" Header="Audit log">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Refresh" Padding="12,4" Click="Refresh_Click" />
                        <TextBlock Text="  Latest 500 events" Foreground="#52606D" VerticalAlignment="Center" />
                    </WrapPanel>
                    <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="140" />
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="130" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="100" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
