<Window x:Class="SpatialEditor.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniDT SE - Block library" Height="620" Width="1060"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <DockPanel Margin="12">
        <StatusBar DockPanel.Dock="Bottom" Background="Transparent" Margin="0,8,0,0">
            <TextBlock x:Name="SummaryText" />
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Category tree -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Categories" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Button x:Name="RenameCategoryButton" DockPanel.Dock="Bottom" Content="Rename category..." Margin="0,6,0,0" Padding="6,3" Click="RenameCategory_Click" IsEnabled="False" />
                <Button x:Name="AddCategoryButton" DockPanel.Dock="Bottom" Content="New category..." Margin="0,6,0,0" Padding="6,3" Click="AddCategory_Click" />
                <TreeView x:Name="CategoryTree" SelectedItemChanged="CategoryTree_SelectedItemChanged" />
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Search + item list -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Padding="4" TextChanged="Filter_Changed" ToolTip="Search code, name, vendor, model" />
                    <TextBlock Grid.Column="1" Text="Status" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <ComboBox x:Name="StatusFilter" Grid.Column="2" Width="110" SelectionChanged="Filter_Changed" />
                </Grid>
                <ListView x:Name="ItemList" SelectionChanged="ItemList_SelectionChanged" MouseDoubleClick="ItemList_DoubleClick"
                          VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Thumbnail}" Width="44" Height="44" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Code" Width="150" DisplayMemberBinding="{Binding Item.Code}" />
                            <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Item.Name}" />
                            <GridViewColumn Header="Category" Width="90" DisplayMemberBinding="{Binding Item.CategoryName}" />
                            <GridViewColumn Header="Size (W x D)" Width="95" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="Status" Width="75" DisplayMemberBinding="{Binding Item.Status}" />
                            <GridViewColumn Header="Used" Width="50" DisplayMemberBinding="{Binding Item.InstanceCount}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Preview + properties -->
            <DockPanel Grid.Column="4">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="EditButton" Content="Edit..." Padding="14,4" Margin="0,0,8,0" Click="Edit_Click" IsEnabled="False" />
                    <Button x:Name="DeleteButton" Content="Delete" Padding="14,4" Margin="0,0,8,0" Click="Delete_Click" IsEnabled="False" />
                    <Button Content="Refresh" Padding="14,4" Click="Refresh_Click" />
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="230" Background="White" BorderBrush="#CBD2D9" BorderThickness="1" CornerRadius="4">
                    <Image x:Name="PreviewImage" Margin="8" Stretch="Uniform" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Text="Select a block to see its details." />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
