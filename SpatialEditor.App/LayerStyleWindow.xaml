<Window x:Class="SpatialEditor.App.LayerStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpatialEditor.App"
        Title="Layer properties" Height="560" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F6F8">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset style" Padding="10,5" Margin="0,0,24,0" Click="Reset_Click" />
            <Button Content="OK" Padding="18,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Padding="18,5" IsCancel="True" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Layer name" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="NameTextBox" MaxLength="255" Padding="3" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Border BorderBrush="#D7DEE5" BorderThickness="1" Background="White" Height="70">
                <Canvas x:Name="PreviewCanvas" ClipToBounds="True" />
            </Border>
        </StackPanel>
        <TabControl>
            <TabItem Header="Line">
                <StackPanel Margin="10">
                    <local:ColorEditor x:Name="LineColorEditor" Margin="0,0,0,12" />
                    <TextBlock Text="Line thickness (screen pixels)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ThicknessSlider" Minimum="0.25" Maximum="8" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                ValueChanged="Thickness_Changed" VerticalAlignment="Center" />
                        <TextBlock x:Name="ThicknessText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Fill">
                <StackPanel Margin="10">
                    <CheckBox x:Name="FillSameCheckBox" Content="Same color as line" Margin="0,0,0,8"
                              Checked="FillSame_Changed" Unchecked="FillSame_Changed" />
                    <local:ColorEditor x:Name="FillColorEditor" Margin="0,0,0,12" />
                    <TextBlock Text="Fill opacity" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="Opacity_Changed" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpacityText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
