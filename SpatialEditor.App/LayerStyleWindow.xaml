<Window x:Class="SpatialEditor.App.LayerStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layer style" Height="430" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F6F8">
    <DockPanel Margin="16">
        <TextBlock x:Name="LayerNameText" DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset to default" Padding="10,5" Margin="0,0,24,0" Click="Reset_Click" />
            <Button Content="OK" Padding="18,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Padding="18,5" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel x:Name="PalettePanel" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="R" VerticalAlignment="Center" />
                <Slider x:Name="RedSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Channel_Changed" Margin="0,2" />
                <TextBlock x:Name="RedText" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" />
                <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Channel_Changed" Margin="0,2" />
                <TextBlock x:Name="GreenText" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" />
                <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Channel_Changed" Margin="0,2" />
                <TextBlock x:Name="BlueText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="HexTextBox" Width="90" MaxLength="7" TextChanged="Hex_TextChanged" />
            </StackPanel>

            <TextBlock Text="Line thickness (screen pixels)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="ThicknessSlider" Minimum="0.25" Maximum="8" TickFrequency="0.25" IsSnapToTickEnabled="True"
                        ValueChanged="Thickness_Changed" VerticalAlignment="Center" />
                <TextBlock x:Name="ThicknessText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Border BorderBrush="#D7DEE5" BorderThickness="1" Background="White" Height="70">
                <Canvas x:Name="PreviewCanvas" ClipToBounds="True" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
