<Window x:Class="SpatialEditor.App.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User" Height="560" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F8">
    <DockPanel Margin="18">
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" MinHeight="20" Foreground="#52606D" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Padding="20,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Padding="20,5" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="ID" Margin="0,6,0,3" />
            <TextBox x:Name="LoginIdTextBox" />
            <TextBlock Text="Name" Margin="0,8,0,3" />
            <TextBox x:Name="NameTextBox" />
            <CheckBox x:Name="ActiveCheckBox" Content="Active (can log in)" IsChecked="True" Margin="0,10,0,0" />
            <StackPanel x:Name="PasswordPanel">
                <TextBlock Text="Initial password" Margin="0,8,0,3" />
                <PasswordBox x:Name="PasswordInput" />
                <TextBlock Text="Confirm password" Margin="0,8,0,3" />
                <PasswordBox x:Name="ConfirmInput" />
                <CheckBox x:Name="MustChangeCheckBox" Content="Require a change at first login" IsChecked="True" Margin="0,8,0,0" />
            </StackPanel>
            <TextBlock Text="Roles" FontWeight="SemiBold" Margin="0,12,0,4" />
            <Border BorderBrush="#D7DEE5" BorderThickness="1" Background="White" Padding="8">
                <StackPanel x:Name="RolesPanel" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
