<Window x:Class="SpatialEditor.App.LayerSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Select layers to load" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F4F6F8">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Load which layers from the database?"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Foreground="#52606D" TextWrapping="Wrap"
                   Text="Only checked layers are fetched from PostgreSQL. Your choice is remembered for next time."
                   Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Select all" Padding="10,5" Margin="0,0,8,0" Click="SelectAll_Click" />
            <Button Content="Select none" Padding="10,5" Margin="0,0,24,0" Click="SelectNone_Click" />
            <Button Content="OK" Padding="18,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Padding="18,5" IsCancel="True" />
        </StackPanel>
        <Border BorderBrush="#D7DEE5" BorderThickness="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LayerListPanel" Margin="10" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
