<Window x:Class="SpatialEditor.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About OmniDT SE" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- The program icon fills the dialog background; the red behind it matches the icon's own gradient. -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F67082" Offset="0" />
                <GradientStop Color="#DE3A54" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Image x:Name="IconImage" VerticalAlignment="Top" HorizontalAlignment="Center" Stretch="Uniform"
               Width="380" Height="380" Margin="0,6,0,0" RenderOptions.BitmapScalingMode="HighQuality" />

        <Border VerticalAlignment="Bottom" Margin="16" Padding="18,14,18,14" CornerRadius="8"
                Background="#EBFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="OmniDT SE" FontSize="22" FontWeight="Bold" Foreground="#A8183A" />
                <TextBlock Text="Spatial Editor" FontSize="12" Foreground="#52606D" Margin="0,0,0,8" />
                <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                <TextBlock x:Name="BuildText" Foreground="#52606D" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" Foreground="#37474F"
                           Text="PostGIS spatial data editor for CAD equipment blocks. Import DXF, edit block objects, manage users and permissions." />
                <Button Content="OK" Padding="26,5" HorizontalAlignment="Right" Margin="0,12,0,0" IsDefault="True" IsCancel="True" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
