<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SpatialEditor.Domain\SpatialEditor.Domain.csproj" />
    <ProjectReference Include="..\SpatialEditor.Geometry\SpatialEditor.Geometry.csproj" />
    <ProjectReference Include="..\SpatialEditor.Infrastructure\SpatialEditor.Infrastructure.csproj" />
    <ProjectReference Include="..\SpatialEditor.Cad\SpatialEditor.Cad.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Product name shown in the exe's file properties -->
    <Product>OmniDT SE (Spatial Editor)</Product>
    <AssemblyTitle>OmniDT SE</AssemblyTitle>
    <Description>OmniDT SE - PostGIS spatial editor for CAD equipment drawings</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Development build number: the date and time of this build (yyyyMMddHHmmss), re-evaluated on every build. -->
    <BuildStamp>$([System.DateTime]::Now.ToString("yyyyMMddHHmmss"))</BuildStamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildStamp</_Parameter1>
      <_Parameter2>$(BuildStamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
