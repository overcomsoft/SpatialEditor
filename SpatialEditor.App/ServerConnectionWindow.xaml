<Window x:Class="SpatialEditor.App.ServerConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniDT SE - Server connection" Height="430" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F6F8" FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="PostgreSQL server" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="34"
                   Foreground="#52606D" Text="Enter the connection details. They are saved and used to connect automatically next time." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ConnectButton" Content="Connect" Padding="20,5" Margin="0,0,8,0" IsDefault="True" Click="Connect_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Padding="20,5" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Host" Margin="0,8,0,3" />
            <TextBox x:Name="HostTextBox" />
            <TextBlock Text="Port" Margin="0,8,0,3" />
            <TextBox x:Name="PortTextBox" />
            <TextBlock Text="Database" Margin="0,8,0,3" />
            <TextBox x:Name="DatabaseTextBox" />
            <TextBlock Text="Username" Margin="0,8,0,3" />
            <TextBox x:Name="UsernameTextBox" />
            <TextBlock Text="Password" Margin="0,8,0,3" />
            <PasswordBox x:Name="PasswordInput" />
        </StackPanel>
    </DockPanel>
</Window>
