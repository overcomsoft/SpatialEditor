<Window x:Class="SpatialEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpatialEditor.App"
        mc:Ignorable="d"
        Title="Spatial Editor" Height="600" Width="1000" Background="#F4F6F8">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F2933" Padding="14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SPATIAL EDITOR" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="  |  EPSG:5186  |  Local preview" Foreground="#B8C4CE" Margin="14,3,0,0" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D7DEE5" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Zoom in" Padding="14,5" Margin="0,0,6,0" Click="ZoomIn_Click" />
                <Button Content="Zoom out" Padding="14,5" Margin="0,0,6,0" Click="ZoomOut_Click" />
                <Button Content="Fit" Padding="14,5" Margin="0,0,6,0" Click="FitView_Click" />
                <Button Content="Reset view" Padding="14,5" Click="ResetView_Click" />
                <TextBlock Text="Scroll: zoom  |  Middle drag: pan  |  Click: select" Foreground="#52606D" VerticalAlignment="Center" Margin="18,0,0,0" />
            </StackPanel>
        </Border>
        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#D7DEE5" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PostgreSQL connection" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Host" Margin="0,14,0,3" />
                    <TextBox x:Name="HostTextBox" />
                    <TextBlock Text="Port" Margin="0,8,0,3" />
                    <TextBox x:Name="PortTextBox" />
                    <TextBlock Text="Database" Margin="0,8,0,3" />
                    <TextBox x:Name="DatabaseTextBox" />
                    <TextBlock Text="Username" Margin="0,8,0,3" />
                    <TextBox x:Name="UsernameTextBox" />
                    <TextBlock Text="Password" Margin="0,8,0,3" />
                    <PasswordBox x:Name="PasswordInput" />
                    <Button Content="Save connection JSON" Margin="0,12,0,0" Click="SaveConnection_Click" />
                    <Button Content="Test PostgreSQL connection" Margin="0,8,0,0" Click="TestConnection_Click" />
                    <Separator Margin="0,18" />
                    <TextBlock Text="Layers" FontSize="16" FontWeight="SemiBold" />
                    <CheckBox Content="Sample polygon" IsChecked="True" Margin="0,18,0,0" />
                    <CheckBox Content="Vertices" IsChecked="True" Margin="0,10,0,0" />
                    <Separator Margin="0,20" />
                    <TextBlock Text="Geometry tools" FontWeight="SemiBold" />
                    <Button x:Name="ImportButton" Content="Import SmartLayout.dxf" Margin="0,12,0,0" Click="ImportDxf_Click" IsEnabled="False" />
                    <Button Content="Add point" Margin="0,12,0,0" Click="AddPoint_Click" />
                    <Button Content="Validate geometry" Margin="0,8,0,0" Click="Validate_Click" />
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#52606D" TextWrapping="Wrap" Margin="0,20,0,0" />
                </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#D7DEE5" BorderThickness="1">
                <Canvas x:Name="MapCanvas" ClipToBounds="True" Background="#FAFBFC"
                        MouseWheel="MapCanvas_MouseWheel"
                        MouseDown="MapCanvas_MouseDown"
                        MouseMove="MapCanvas_MouseMove"
                        MouseUp="MapCanvas_MouseUp">
                    <Canvas x:Name="MapLayerCanvas" />
                </Canvas>
            </Border>
            <Border Grid.Column="4" Background="White" BorderBrush="#D7DEE5" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="Object properties" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedObjectText" Text="No object selected" Foreground="#52606D" TextWrapping="Wrap" Margin="0,18,0,0" />
                    <Separator Margin="0,18" />
                    <TextBlock x:Name="PropertyDetailsText" Foreground="#263238" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
